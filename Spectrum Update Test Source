    function Window:SetTheme(newThemeName)
        local t = Themes[newThemeName]
        if not t then return end
        Theme = t
        Window.Theme = newThemeName

        for _, entry in ipairs(ThemeRegistry) do
            if entry.Instance and entry.Instance.Parent then entry.Instance[entry.Property] = t[entry.Key] end
        end
        for _, cb in ipairs(ThemeCallbacks) do pcall(cb, t) end
        for _, tb in ipairs(Window.Tabs) do
            if tb.Page.Visible then
                tb.Button.BackgroundColor3 = t.Accent
                tb.Button.BackgroundTransparency = 0.1
                tb.Label.TextColor3 = Color3.new(1, 1, 1)
            else
                tb.Button.BackgroundColor3 = t.Tertiary
                tb.Button.BackgroundTransparency = 0.35
                tb.Label.TextColor3 = t.SubText
            end
        end
    end

