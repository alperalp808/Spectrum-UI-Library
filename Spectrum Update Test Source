                end)

                local API = { Instance = Frame }
                function API:Refresh(newOptions) Options = newOptions BuildOptions() end
                function API:Set(value) Selected = value DropBtn.Text = "  " .. tostring(Selected) BuildOptions() task.spawn(Callback, Selected) end
                function API:Get() return Selected end
                return API
            end

            table.insert(Tab.Sections, Section)
