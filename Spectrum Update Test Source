        local lastUpdate = tick()
        local frameCount = 0
        RunService.RenderStepped:Connect(function()
            frameCount = frameCount + 1
            local now = tick()
            if now - lastUpdate >= 0.5 then
                local fps = math.floor(frameCount / (now - lastUpdate))
                FpsLbl.Instance:FindFirstChildOfClass("TextLabel").Text = "FPS: " .. tostring(fps)
                frameCount = 0
                lastUpdate = now

                pcall(function()
                    local ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
                    PingLbl.Instance:FindFirstChildOfClass("TextLabel").Text = "Ping: " .. tostring(ping) .. " ms"

                    local mem = math.floor(StatsService:GetTotalMemoryUsageMb())
                    MemLbl.Instance:FindFirstChildOfClass("TextLabel").Text = "Bellek: " .. tostring(mem) .. " MB"
                end)
            end
        end)

        -- SAĞ SÜTUN
        local RightSec = DashTab:AddSection("Karakter Durumu", "Right")
        local PosLbl = RightSec:AddButton({ Name = "CFrame: 0, 0, 0" })
        local VelLbl = RightSec:AddButton({ Name = "Velocity: 0, 0, 0" })

        RunService.Heartbeat:Connect(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                local pos = hrp.Position
                local vel = hrp.AssemblyLinearVelocity
                PosLbl.Instance:FindFirstChildOfClass("TextLabel").Text = string.format("Pos: %.1f, %.1f, %.1f", pos.X, pos.Y, pos.Z)
                VelLbl.Instance:FindFirstChildOfClass("TextLabel").Text = string.format("Vel: %.1f, %.1f, %.1f", vel.X, vel.Y, vel.Z)
            end
        end)

        local ToolSec = DashTab:AddSection("Envanterdeki Toollar", "Right")
        local ToolListLbl = ToolSec:AddButton({ Name = "Toollar Yükleniyor..." })

        local function RefreshTools()
            local toolNames = {}
            if LocalPlayer.Character then
                for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
                    if item:IsA("Tool") then table.insert(toolNames, "[Eklendi] " .. item.Name) end
                end
            end
            if LocalPlayer:FindFirstChild("Backpack") then
                for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
                    if item:IsA("Tool") then table.insert(toolNames, item.Name) end
                end
            end
            ToolListLbl.Instance:FindFirstChildOfClass("TextLabel").Text = #toolNames > 0 and table.concat(toolNames, ", ") or "Tool Yok"
        end
        task.spawn(function()
            while task.wait(2) do RefreshTools() end
        end)

        -- ALT SÜTUN (Profil Fotolu & Tuşlar Sağda Oyuncu Listesi)
        local PlayerSec = DashTab:AddSection("Oyuncu Listesi & Yönetim", "Bottom")
        
        local PlayerListContainer = Create("Frame", {
            Name = "PlayerListContainer",
            Size = UDim2.new(1, 0, 0, 200),
            BackgroundColor3 = Theme.Tertiary,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            Parent = PlayerSec.ElementHolder,
        })
        Themed(PlayerListContainer, "BackgroundColor3", "Tertiary")
        Themed(Stroke(PlayerListContainer, Theme.Stroke, 1, 0.3), "Color", "Stroke")

        local PlayerScroll = Create("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Parent = PlayerListContainer,
        })
        Pad(PlayerScroll, 6, 6, 6, 6)
        Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = PlayerScroll })

        local activeSpectateTarget = nil

        local function UpdatePlayerList()
            for _, child in ipairs(PlayerScroll:GetChildren()) do
                if child:IsA("Frame") then child:Destroy() end
            end

            for _, targetPlayer in ipairs(Players:GetPlayers()) do
                if targetPlayer ~= LocalPlayer then
                    local Row = Create("Frame", {
                        Size = UDim2.new(1, 0, 0, 36),
                        BackgroundColor3 = Theme.Secondary,
                        BackgroundTransparency = 0.2,
                        BorderSizePixel = 0,
                        Parent = PlayerScroll,
                    })
                    Themed(Row, "BackgroundColor3", "Secondary")
                    Themed(Stroke(Row, Theme.Stroke, 1, 0.4), "Color", "Stroke")

                    -- Sol Taraf: Profil Fotoğrafı
                    local PImg = Create("ImageLabel", {
                        Size = UDim2.new(0, 28, 0, 28),
                        Position = UDim2.new(0, 4, 0.5, -14),
                        BackgroundColor3 = Theme.Tertiary,
                        BackgroundTransparency = 0.5,
                        Image = "rbxassetid://0",
                        Parent = Row,
                    })
                    Themed(PImg, "BackgroundColor3", "Tertiary")
                    Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = PImg })

                    task.spawn(function()
                        local pThumb = Players:GetUserThumbnailAsync(targetPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                        if PImg and PImg.Parent then PImg.Image = pThumb end
                    end)

                    -- Orta Taraf: Oyuncu İsmi
                    Themed(Create("TextLabel", {
                        Size = UDim2.new(1, -160, 1, 0),
                        Position = UDim2.new(0, 38, 0, 0),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamMedium,
                        Text = targetPlayer.DisplayName .. " (@" .. targetPlayer.Name .. ")",
                        TextColor3 = Theme.Text,
                        TextSize = 11,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                        Parent = Row,
                    }), "TextColor3", "Text")

                    -- Sağ Taraf: Tuşlar (Işınlan & İzle)
                    local isSpectating = (activeSpectateTarget == targetPlayer)
                    local SpectateBtn = Create("TextButton", {
                        Size = UDim2.new(0, 52, 0, 22),
                        Position = UDim2.new(1, -58, 0.5, -11),
                        BackgroundColor3 = isSpectating and Theme.Accent or Theme.Tertiary,
                        BackgroundTransparency = 0.1,
                        Text = isSpectating and "İzleniyor" or "İzle",
                        Font = Enum.Font.GothamBold,
                        TextSize = 10,
                        TextColor3 = Theme.Text,
                        AutoButtonColor = false,
                        Parent = Row,
                    })
                    Themed(SpectateBtn, "BackgroundColor3", isSpectating and "Accent" or "Tertiary")
                    Themed(SpectateBtn, "TextColor3", "Text")

                    SpectateBtn.MouseButton1Click:Connect(function()
                        ClickBounce(SpectateBtn)
                        PlaySound(Sounds.Click, 0.3)
                        if activeSpectateTarget == targetPlayer then
                            activeSpectateTarget = nil
                            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                                workspace.CurrentCamera.CameraSubject = LocalPlayer.Character.Humanoid
                            end
                            Window:Notify({ Title = "Spectate Kapalı", Content = "Kendi kameranıza dönüldü.", Duration = 2 })
                        else
                            activeSpectateTarget = targetPlayer
                            if targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
                                workspace.CurrentCamera.CameraSubject = targetPlayer.Character.Humanoid
                            end
                            Window:Notify({ Title = "Spectate Açık", Content = targetPlayer.Name .. " izleniyor.", Duration = 2 })
                        end
                        UpdatePlayerList()
                    end)

                    local TeleportBtn = Create("TextButton", {
                        Size = UDim2.new(0, 52, 0, 22),
                        Position = UDim2.new(1, -116, 0.5, -11),
                        BackgroundColor3 = Theme.Accent,
                        BackgroundTransparency = 0.1,
                        Text = "Işınlan",
                        Font = Enum.Font.GothamBold,
                        TextSize = 10,
                        TextColor3 = Color3.new(1, 1, 1),
                        AutoButtonColor = false,
                        Parent = Row,
                    })
                    Themed(TeleportBtn, "BackgroundColor3", "Accent")

                    TeleportBtn.MouseButton1Click:Connect(function()
                        ClickBounce(TeleportBtn)
                        PlaySound(Sounds.Click, 0.3)
                        if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                            Window:Notify({ Title = "Işınlanma", Content = targetPlayer.Name .. " adlı oyuncuya ışınlanıldı.", Duration = 2 })
                        end
                    end)
                end
            end
        end

        Players.PlayerAdded:Connect(UpdatePlayerList)
        Players.PlayerRemoving:Connect(function(plr)
            if activeSpectateTarget == plr then
                activeSpectateTarget = nil
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                    workspace.CurrentCamera.CameraSubject = LocalPlayer.Character.Humanoid
                end
            end
            UpdatePlayerList()
        end)
        UpdatePlayerList()
    end

    return Window
end

return Spectrum
